{
  "name": "the-crochet-center",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.cjs",
    "dev": "node --watch --env-file-if-exists=.env server.cjs",
    "check": "node --check server.cjs && node --check lib/store.cjs && node --check assets/app.js && node --check assets/admin.js",
    "test": "node --test test/*.test.cjs",
    "build": "node scripts/build.cjs",
    "build:pages": "node scripts/build-pages.cjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0"
  }
}
